\contentsline {figure}{\numberline {1.1}{\ignorespaces Iterative density-based topology optimization process: (a) initialization with a uniform field, (b) intermediate continuous distribution where $\gamma \in [0, 1]$, and (c) final discrete fluid topology where $\gamma \in \{0, 1\}$.}}{2}{figure.caption.15}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Topology optimized manifolds with turbulent flow. Adapted from Dilgen et al. \cite {Dilgen2018}.}}{3}{figure.caption.16}%
\addvspace {10pt}
\contentsline {figure}{\numberline {2.1}{\ignorespaces Streamwise velocity profiles in a $90^\circ $ pipe bend ($R_c = 7D$, $Re_D \approx 34,000$, $De \approx 9,000$). The SA model performs relatively well, closely matching the experimental data and two-equation models for mild curvature. Reprinted from Apalowo \cite {Apalowo2022}.}}{10}{figure.caption.17}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Turbulence model predictions in a strongly curved internal U-duct ($R_c \approx 0.83H$, $Re_H = 100,000$, $De \approx 109,500$). Due to the extreme curvature, the standard Spalart-Allmaras model overpredicts eddy viscosity and fails to capture the inner-wall separation. Adapted from Rumsey et al. \cite {Rumsey2000}.}}{11}{figure.caption.18}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Comparison of velocity contours in a $180^\circ $ U-bend ($R_c \approx 4.46D$, $Re_D \approx 44,700$, $De \approx 15,000$). The SA model performs well, closely matching the high-fidelity prediction.}}{12}{figure.caption.19}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Comparison of velocity contours in a $90^\circ $ pipe bend ($R_c = 2.8D$, $Re_D \approx 43,000$, $De \approx 18,000$). The SA model over-smooths the velocity gradients compared to the $k-\omega $ SST model.}}{13}{figure.caption.20}%
\addvspace {10pt}
\contentsline {figure}{\numberline {3.1}{\ignorespaces Quantitative code verification: line plots extracting data across the 2D periodic channel ($Re_H \approx 20,300$). The custom FEniCS SA formulation demonstrates excellent numerical agreement with the commercial Ansys Fluent SA baseline.}}{22}{figure.caption.21}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Code verification: qualitative velocity contours of the truncated 2D U-bend benchmark comparing the custom FEniCS implementation against Ansys Fluent. Both solvers utilize the Spalart-Allmaras model.}}{23}{figure.caption.22}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Quantitative validation: velocity profile across the U-bend exit ($R_c \approx 4.46D$, $Re_D \approx 44,700$, $De \approx 15,000$), comparing the custom FEniCS SA solver directly to the truncated Ansys Fluent baseline.}}{24}{figure.caption.23}%
\addvspace {10pt}
\addvspace {10pt}
\contentsline {figure}{\numberline {5.1}{\ignorespaces Current diffuser benchmark geometry and boundary-condition layout. This figure can be retained for the final manuscript unless the diffuser definition itself is modified.}}{43}{figure.caption.25}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Minimum figure set for the diffuser FEniCS-SA optimization results. The existing topology can be retained; the remaining panels should be replaced with the final post-processed fields.}}{44}{figure.caption.26}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Minimum Ansys comparison set for the diffuser case. The key comparison is FEniCS-SA versus Ansys-SA; the SST result is the primary model-sensitivity check.}}{45}{figure.caption.27}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Current double-pipe benchmark geometry and boundary-condition layout.}}{46}{figure.caption.29}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Minimum figure set for the double-pipe FEniCS-SA results.}}{47}{figure.caption.30}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Minimum Ansys comparison set for the double-pipe benchmark.}}{48}{figure.caption.31}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Current curved benchmark schematic from the working code base. If the Bayat--Li--Alexandersen pipe-bend or U-bend is adopted for the final Chapter 5 campaign, this figure should be replaced by the corresponding updated geometry and boundary-condition definition.}}{50}{figure.caption.33}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Minimum figure set for the curved benchmark FEniCS-SA results.}}{51}{figure.caption.34}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Minimum Ansys comparison set for the curved benchmark.}}{52}{figure.caption.35}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Current semi-frozen topologies. These results should be interpreted as exploratory only. Before claiming any superiority over the frozen adjoint, the final study should introduce non-design inlet and outlet regions and use turbulent boundary conditions that do not inject artificial shear singularities at the design boundary.}}{53}{figure.caption.37}%
